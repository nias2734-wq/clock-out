{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true,
    "skipLibCheck": true, "noEmit": true, "esModuleInterop": true, "resolveJsonModule": true,
    "types": ["node"], "lib": ["ES2022", "DOM"],
    "baseUrl": ".", "paths": { "@shared/*": ["shared/*"], "@/*": ["src/*"] }
  },
  "include": ["electron", "src", "shared", "scripts"]
}
