{
  "name": "clock-out-app",
  "productName": "clock-out",
  "version": "0.13.0",
  "description": "Clock out. Your Claude Code schedules keep working. Desktop app: status bar, schedule list, session revival.",
  "main": "./out/main/index.js",
  "private": true,
  "license": "MIT",
  "author": "nias2734-wq",
  "homepage": "https://github.com/nias2734-wq/clock-out#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nias2734-wq/clock-out.git",
    "directory": "app"
  },
  "bugs": {
    "url": "https://github.com/nias2734-wq/clock-out/issues"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win nsis",
    "test": "vitest run",
    "icon": "node scripts/make-icon.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "io.github.shlee-commits.clock-out",
    "productName": "clock-out",
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "artifactName": "clock-out-setup-${version}.exe",
    "extraResources": [
      {
        "from": "..",
        "to": "plugin",
        "filter": [
          ".claude-plugin/plugin.json",
          ".claude-plugin/marketplace.json",
          "hooks/**/*",
          "commands/**/*",
          "types/**/*",
          "service/**/*",
          "README.md",
          "LICENSE"
        ]
      }
    ]
  }
}
